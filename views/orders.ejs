<!DOCTYPE html>
<html lang="en">
    <!--EJS vars: %title, %content, %user-->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Prevent unthemed content from flashing on reload -->
    <script src="/js/prevent-unthemed-flash.js"></script> 

    <!-- Favicon -->
    <link rel="icon" href="img/stockify-favicon-32x32.png" type="image/x-icon">

   <!-- Bootstrap call -->
    <%- include("partials/bootstrap-call.ejs") %>
    <%- include("partials/fonts-call.ejs") %> 

    <!-- CSS call -->
    <link rel="stylesheet" href="/css/variables.css">
    <link rel="stylesheet" href="/css/orders.css">
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <title><%= title %></title>
</head>

<body>
    <%- include('partials/header') %> 

    <main class="flex-grow-1">
        <div class="container mt-2">
             <!-- Header row (separate) -->
            <div class="row">
                <div class="col-12">
                <span class="h1">Orders</span>
                <hr class="w-100">
                </div>
            </div>
            <div class="card">
                <% if (orders.length === 0) { %>
                <div class="no-orders">No orders to display</div>
                <% } else { %>
                <div class="container" id="orderList">
                    <% orders.forEach(({ order_id, status, user_id, created_at, updated_at, items, user_name }) => { %>
                    <div class="order-card">
                        <!-- Collapsed Order Row -->
                        <div class="order-row">
                            <span class="order-row-number">ORD-<%= String(order_id).padStart(4, "0") %></span>
                            <div class="order-row-wrapper">
                                <% const assignedClass = status === 'assigned' ? 'assigned' : ''; %>
                                <span class="order-row-status <%= assignedClass %>">
                                  <%= status === "unassigned" ? "not assigned" : status %>
                                </span>
                                <span class="order-row-dropdown"><i class="fa fa-caret-down"></i></span>
                            </div>
                        </div>

                        <!-- Expanded Order Row -->
                        <div class="order-row-body">
                             <!-- ORDER-DETAILS HEADER -->
                            <div class="order-header-left">Details</div>
                            
                            <!-- ORDER-DETAILS LIST CONTAINER -->
                            <div class="order-details-container">

                                <div class="order-details-list">
                                    <div class="order-details-list-row">  
                                        <span>Assigned To: </span>
                                        <span class="assigned-to"><%=  user_name || "N/A"%></span>
                                    </div>
                                    <div class="order-details-list-row">  
                                        <span>Status: </span>
                                        <span class="status"><%=  status %></span>
                                    </div>
                                    <div class="order-details-list-row">  
                                        <span>Submitted: </span>
                                        <span><%= new Date(created_at).toLocaleString() %></span>
                                    </div>
                                    <div class="order-details-list-row assigned-at <%= status !== 'assigned' ? 'hidden-display' : '' %>">  
                                        <span>Assigned: </span>
                                        <span><%= new Date(updated_at).toLocaleString() %></span>
                                    </div>
                                </div>

                                <button class="assign-order-btn <%= status !== 'assigned' ? '' : 'hidden-fade' %>" type="button" data-order-id="<%= order_id %>">
                                    Assign to Me
                                </button>

                            </div>
                             <!-- ORDER-ITEMS HEADER -->
                            <div class="order-header-right">Items</div>
                            <div class="order-items-container">
                                <!-- ORDER-ITEMS LIST -->
                                <div class="order-items-list">
                                <% items.forEach(({ name, quantity }) => { %>
                                    <div class="order-items-list-row">  
                                        <span><%= name %></span>
                                        <span>x</span>
                                        <span><%= quantity %></span>
                                        <div class="item-ready-wrap">
                                            <button class="item-ready-button <%= status !== 'assigned' ? 'hidden-fade' : '' %>" type="button">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                            <span class="submit-message">Picked</span>
                                        </div>
                                    </div>
                                <% }) %>   
                                </div>
                                    <button class="submit-order-btn <%= status !== 'assigned' ? 'hidden-fade' : '' %>" data-order-id="<%= order_id %>">
                                        Submit
                                    </button>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
                <% } %>
            </div>
            
        </div>
    </main>
    
    <%- include('partials/footer') %> 
<!-- SCRIPTS -->
    <script src="/js/orders-client.js" defer></script>
    <script src="/js/toggle-theme.js" defer></script>
</body>
</html>